# Copy this file to `.env` and set your GCP PROJECT_ID:
#   cp .env.example .env
#
# Everything below PROJECT_ID has sensible defaults tuned for Salt Lake City
# (us-west3) and can be left as-is or overridden.

# REQUIRED: Your Google Cloud Project ID
export PROJECT_ID=""

# OPTIONAL: Region & Zone (defaults to us-west3 = Salt Lake City, Utah)
# Other nearby us-west options: us-west1 (Oregon), us-west2 (Los Angeles), us-west4 (Las Vegas)
export GCE_REGION="${GCE_REGION:-us-west3}"
export CLUSTER_LOCATION="${CLUSTER_LOCATION:-${GCE_REGION}-a}"

# OPTIONAL: GKE Cluster & Node Pool settings
export CLUSTER_NAME="${CLUSTER_NAME:-anything-but-agents}"
export NODE_MACHINE_TYPE="${NODE_MACHINE_TYPE:-c3-standard-4}"
export ENABLE_NESTED_VIRTUALIZATION="${ENABLE_NESTED_VIRTUALIZATION:-true}"
export NETWORK="${NETWORK:-default}"
export SUBNETWORK="${SUBNETWORK:-default}"

# OPTIONAL: Derived automatically from PROJECT_ID if left empty
export BUCKET_NAME="${BUCKET_NAME:-}"
export KO_DOCKER_REPO="${KO_DOCKER_REPO:-}"
export CLUSTER_VERSION="${CLUSTER_VERSION:-}"
export ATE_CREDENTIAL_PROVIDER='{"name":"k8s.io"}'
export KO_DEFAULTPLATFORMS="${KO_DEFAULTPLATFORMS:-linux/amd64}"

# OPTIONAL: Path to the Agent Substrate repository (defaults to parent directory `..`)
export SUBSTRATE_ROOT="${SUBSTRATE_ROOT:-}"

# OPTIONAL: GKE Gateway API + Google Cloud Certificate Manager domain settings
export DEMO_DOMAIN="${DEMO_DOMAIN:-substrate.learngke.dev}"
export GATEWAY_IP_NAME="${GATEWAY_IP_NAME:-substrate-learngke-ip}"
export CERT_MAP_NAME="${CERT_MAP_NAME:-substrate-learngke-map}"

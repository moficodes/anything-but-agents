# Demo 1: "Look Ma, No Database" — Zork-style Dungeon where 100% of state
# lives in Go heap variables preserved by SNAPSHOT_FIDELITY_MEMORY.
metadata:
  atespace: anything-but-agents
  name: dungeon
workerSelector:
  matchLabels:
    workload: anything-but-agents
containers:
- name: dungeon
  image: ko://github.com/moficodes/anything-but-agents/cmd/dungeon
  command:
  - /ko-app/dungeon
  wakeupProbe:
    httpGet:
      path: /readyz
      port: 80
resources:
  limits:
    cpuMillicores: 1000
    memoryBytes: 536870912 # 512Mi
snapshotConfig:
  preferredFidelity: SNAPSHOT_FIDELITY_MEMORY
  storageLocation: gs://${BUCKET_NAME}/anything-but-agents/dungeon/

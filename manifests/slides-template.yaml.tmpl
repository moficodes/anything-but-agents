# Demo 0: "Slides on Substrate" — Presentation deck where every individual
# slide is its own gVisor-sandboxed actor sleeping in GCS, waking on HTTP over
# atenet-router, incrementing its heap state, and suspending on navigation.
metadata:
  atespace: anything-but-agents
  name: slides
workerSelector:
  matchLabels:
    workload: slides
containers:
- name: slides
  image: ko://github.com/moficodes/anything-but-agents/cmd/slides
  command:
  - /ko-app/slides
  - --mode=actor
  - --addr=:80
  wakeupProbe:
    httpGet:
      path: /readyz
      port: 80
resources:
  limits:
    cpuMillicores: 250
    memoryBytes: 134217728 # 128Mi (fits 3 concurrent slides per 512Mi wp-slides pod)
snapshotConfig:
  preferredFidelity: SNAPSHOT_FIDELITY_MEMORY

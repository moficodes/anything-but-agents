# Demo 1B: "Save-Scumming the Heap Dragon (2D Edition)" — Multilevel 2D Dungeon
# where each player's session lives 100% in Go heap RAM, wakes on milestones
# via atenet-router, and immediately suspends back to GCS.
metadata:
  atespace: anything-but-agents
  name: dungeon2d
workerSelector:
  matchLabels:
    workload: anything-but-agents
containers:
- name: dungeon2d
  image: ko://github.com/moficodes/anything-but-agents/cmd/dungeon2d
  command:
  - /ko-app/dungeon2d
  - --mode=actor
  - --addr=:80
  wakeupProbe:
    httpGet:
      path: /readyz
      port: 80
resources:
  limits:
  - name: cpu
    quantity: "1"
  - name: memory
    quantity: 512Mi
snapshotConfig:
  onPause: SNAPSHOT_CONTENT_SCOPE_FULL
  onCommit: SNAPSHOT_CONTENT_SCOPE_FULL
  storageLocation: gs://${BUCKET_NAME}/anything-but-agents/dungeon2d/
sandboxConfig:
  sandboxClass: SANDBOX_CLASS_GVISOR
  configName: gvisor-default

# Demo 2: "The Instant Cloner & Production HPA QPS Race" — Runs a 12-second
# cold-start initialization (building a 50,000-document inverted token & 3-gram
# search index + prime lookup table in Go heap RAM) ONCE during Golden Snapshot
# creation (before /readyz returns 200 OK).
# Every Actor created from this template restores in ~100ms with the ~65MB
# precomputed search index and golden_heap_fingerprint already warm in RAM.
metadata:
  atespace: anything-but-agents
  name: coldstart
workerSelector:
  matchLabels:
    workload: anything-but-agents
containers:
- name: coldstart
  image: ko://github.com/moficodes/anything-but-agents/cmd/coldstart
  command:
  - /ko-app/coldstart
  - --mode=worker
  - --init-delay=12s
  - --corpus-docs=50000
  - --sieve-limit=1000000
  - --max-concurrent=4
  - --min-query-duration=200ms
  wakeupProbe:
    httpGet:
      path: /readyz
      port: 80
resources:
  limits:
  - name: cpu
    quantity: "1"
  - name: memory
    quantity: 512Mi
snapshotConfig:
  onPause: SNAPSHOT_CONTENT_SCOPE_FULL
  onCommit: SNAPSHOT_CONTENT_SCOPE_FULL
  storageLocation: gs://${BUCKET_NAME}/anything-but-agents/coldstart/
sandboxConfig:
  sandboxClass: SANDBOX_CLASS_GVISOR
  configName: gvisor-default

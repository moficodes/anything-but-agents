# Demo 3: "One Database Process Per Customer" — Combines a DurableDir volume
# (/data) with SNAPSHOT_CONTENT_SCOPE_FULL on Pause (keeping the RAM buffer
# pool hot on the node) and SNAPSHOT_CONTENT_SCOPE_DATA on Commit (persisting
# only the compact /data WAL to GCS when suspended).
metadata:
  atespace: anything-but-agents
  name: tenantdb
workerSelector:
  matchLabels:
    workload: anything-but-agents
containers:
- name: tenantdb
  image: ko://github.com/mofi/anything-but-agents/cmd/tenantdb
  command:
  - /ko-app/tenantdb
  - --data-dir=/data
  wakeupProbe:
    httpGet:
      path: /readyz
      port: 80
  volumeMounts:
  - name: data
    mountPath: /data
resources:
  limits:
  - name: cpu
    quantity: "1"
  - name: memory
    quantity: 512Mi
snapshotConfig:
  onPause: SNAPSHOT_CONTENT_SCOPE_FULL
  onCommit: SNAPSHOT_CONTENT_SCOPE_DATA
  storageLocation: gs://${BUCKET_NAME}/anything-but-agents/tenantdb/
sandboxConfig:
  sandboxClass: SANDBOX_CLASS_GVISOR
  configName: gvisor-default
volumes:
- name: data
  durableDir: {}

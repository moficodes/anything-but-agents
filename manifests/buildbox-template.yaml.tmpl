# Demo 6: "The 3-Stage Hermetic CI/CD Build Pipeline" — Hermetic SLSA L3 build runner.
# Uses SNAPSHOT_FIDELITY_MEMORY so the warm Go heap dependency & compiler cache
# is preserved across turns while ActorEgressPolicy is hot-swapped dynamically.
metadata:
  atespace: anything-but-agents
  name: buildbox
workerSelector:
  matchLabels:
    workload: buildbox
containers:
- name: buildbox
  image: ko://github.com/moficodes/anything-but-agents/cmd/buildbox
  command:
  - /ko-app/buildbox
  - --mode=actor
  - --addr=:80
  wakeupProbe:
    httpGet:
      path: /readyz
      port: 80
resources:
  limits:
    cpuMillicores: 500
    memoryBytes: 201326592 # 192Mi (fits 2 concurrent sandboxes per 512Mi wp-buildbox pod)
snapshotConfig:
  preferredFidelity: SNAPSHOT_FIDELITY_MEMORY

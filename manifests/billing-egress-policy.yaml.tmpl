# Demo 7: Deny-by-default EgressPolicy + MITM Egress Credential Injection (ate-secret://) + Actor JWT.
# In gVisor actor sandboxes (nameserver 169.254.17.1), outbound URLs must use full .svc.cluster.local FQDNs.
# Outbound traffic to the Payment Vault replaces Authorization header with real K8s Secret token
# and injects a cryptographic Actor JWT (actorJwt effect).
metadata:
  atespace: anything-but-agents
  name: default
rules:
- http:
    hostnames:
    - billing-gateway.anything-but-agents.svc.cluster.local
    effects:
      replaceHeaders:
      - header: Authorization
        prefix: "Bearer "
        credentialUri: ate-secret://k8s.io/default/anything-but-agents/billing-vault-api/token
      - header: X-Actor-Identity-JWT
        actorJwt:
          audiences:
          - "https://billing-gateway.anything-but-agents.svc.cluster.local"
          expirationSeconds: 900

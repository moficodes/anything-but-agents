# In-cluster "Truman Show" Honeypot Split-Screen UI & Gateway Deployment and
# LoadBalancer Service so the Attacker Movie Set vs. SOC Director's Booth UI can
# be accessed directly over a GKE LoadBalancer IP.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: honeypot-gateway
  namespace: anything-but-agents
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: honeypot-gateway-ate-client
rules:
- apiGroups: ["certificates.k8s.io"]
  resources: ["clustertrustbundles"]
  verbs: ["get", "list", "watch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: honeypot-gateway-ate-client
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: honeypot-gateway-ate-client
subjects:
- kind: ServiceAccount
  name: honeypot-gateway
  namespace: anything-but-agents
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: honeypot-gateway-token-minter
  namespace: ate-system
rules:
- apiGroups: [""]
  resources: ["serviceaccounts/token"]
  resourceNames: ["ate-client"]
  verbs: ["create"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: honeypot-gateway-token-minter
  namespace: ate-system
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: honeypot-gateway-token-minter
subjects:
- kind: ServiceAccount
  name: honeypot-gateway
  namespace: anything-but-agents
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: honeypot-gateway
  namespace: anything-but-agents
  labels:
    app: honeypot-gateway
spec:
  replicas: 1
  selector:
    matchLabels:
      app: honeypot-gateway
  template:
    metadata:
      labels:
        app: honeypot-gateway
    spec:
      serviceAccountName: honeypot-gateway
      initContainers:
      - name: copy-kubectl-ate
        image: ${KUBECTL_ATE_IMAGE}
        command: ["/bin/cp", "/ko-app/kubectl-ate", "/tools/kubectl-ate"]
        volumeMounts:
        - name: tools
          mountPath: /tools
      containers:
      - name: gateway
        image: ko://github.com/moficodes/anything-but-agents/cmd/honeypot
        command:
        - /ko-app/honeypot
        - --mode=gateway
        - --addr=:8084
        - --atespace=anything-but-agents
        - --template=honeypot
        - --router-url=http://atenet-router.ate-system.svc.cluster.local:80
        - --ate-endpoint=api.ate-system.svc:443
        - --kubectl-ate-bin=/tools/kubectl-ate
        volumeMounts:
        - name: tools
          mountPath: /tools
        ports:
        - containerPort: 8084
          name: http
        readinessProbe:
          httpGet:
            path: /readyz
            port: 8084
      volumes:
      - name: tools
        emptyDir: {}
---
apiVersion: v1
kind: Service
metadata:
  name: honeypot-gateway
  namespace: anything-but-agents
spec:
  type: LoadBalancer
  selector:
    app: honeypot-gateway
  ports:
  - name: http
    port: 80
    targetPort: 8084

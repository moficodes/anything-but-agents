# Demo 5: "Don't Try This at Home" — Anti-pattern demo showing Wall-Clock
# Time-Jump Shock and Raft Split-Brain when a consensus/heartbeat node is
# suspended and resumed.
metadata:
  atespace: anything-but-agents
  name: timewarp
workerSelector:
  matchLabels:
    workload: timewarp
containers:
- name: timewarp
  image: ko://github.com/moficodes/anything-but-agents/cmd/timewarp
  command:
  - /ko-app/timewarp
  wakeupProbe:
    httpGet:
      path: /readyz
      port: 80
resources:
  limits:
    cpuMillicores: 300
    memoryBytes: 134217728 # 128Mi (fits 3 concurrent Raft actors per 512Mi wp-timewarp pod)
snapshotConfig:
  preferredFidelity: SNAPSHOT_FIDELITY_MEMORY

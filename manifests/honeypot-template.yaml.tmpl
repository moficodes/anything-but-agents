# Demo 4: "The Truman Show Honeypot" — On-demand gVisor sandbox per attacker IP.
# Uses SNAPSHOT_CONTENT_SCOPE_FULL so both the rootfs overlay (/tmp/honeypot/*)
# and the in-memory forensic audit log survive across suspends.
metadata:
  atespace: anything-but-agents
  name: honeypot
workerSelector:
  matchLabels:
    workload: anything-but-agents
containers:
- name: honeypot
  image: ko://github.com/moficodes/anything-but-agents/cmd/honeypot
  command:
  - /ko-app/honeypot
  wakeupProbe:
    httpGet:
      path: /readyz
      port: 80
resources:
  limits:
  - name: cpu
    quantity: "1"
  - name: memory
    quantity: 512Mi
snapshotConfig:
  onPause: SNAPSHOT_CONTENT_SCOPE_FULL
  onCommit: SNAPSHOT_CONTENT_SCOPE_FULL
  storageLocation: gs://${BUCKET_NAME}/anything-but-agents/honeypot/
sandboxConfig:
  sandboxClass: SANDBOX_CLASS_GVISOR
  configName: gvisor-default

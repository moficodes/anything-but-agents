# Demo 7: "The 30-Day Sleeping Subscription Billing & Escrow Engine"
# Stateful enterprise subscription actor holding multi-month invoice ledgers
# and escrow state in Go heap RAM, sleeping in GCS for 30 days between billing turns.
# Demonstrates zero secrets in actor RAM/env/snapshots via ate-secret://
# egress credential injection and zero-downtime key rotation across frozen GCS snapshots.
metadata:
  atespace: anything-but-agents
  name: billing
workerSelector:
  matchLabels:
    workload: billing
containers:
- name: billing
  image: ko://github.com/moficodes/anything-but-agents/cmd/billing
  command:
  - /ko-app/billing
  env:
  - name: SSL_CERT_FILE
    value: /run/ate/trust-bundle.pem
  - name: SSL_CERT_DIR
    value: /run/ate
  - name: PAYMENT_VAULT_TOKEN
    value: ate-secret://k8s.io/default/anything-but-agents/billing-vault-api/token
  - name: PAYMENT_VAULT_URL
    value: http://billing-gateway.anything-but-agents.svc.cluster.local/api/vault/charge
  - name: ECHO_SERVICE_URL
    value: http://untrusted-echo.anything-but-agents.svc.cluster.local/api/echo
  volumeMounts:
  - name: system-info
    mountPath: /run/ate
  wakeupProbe:
    httpGet:
      path: /readyz
      port: 80
volumes:
- name: system-info
  systemInfo:
    dataSources:
    - trustBundle:
        names:
        - egress-mitm.ate.dev
        - system-roots.ate.dev
        path: trust-bundle.pem
resources:
  limits:
    cpuMillicores: 500
    memoryBytes: 201326592 # 192Mi (fits 2 concurrent actors per 512Mi wp-billing pod)
snapshotConfig:
  preferredFidelity: SNAPSHOT_FIDELITY_MEMORY

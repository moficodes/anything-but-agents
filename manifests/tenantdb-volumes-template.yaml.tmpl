# Demo 3: Native SNAPSHOT_FIDELITY_VOLUMES ActorTemplate alongside tenantdb
# (SNAPSHOT_FIDELITY_MEMORY). On suspend, Substrate snapshots only the mounted
# DurableDir (/data/wal.jsonl, ~480 B) and discards the 16.0 MB disposable RAM
# buffer pool automatically (99.997% GCS bandwidth saved). On wakeup, PID 1
# boots fresh with /data attached and replays /data/wal.jsonl in <1ms.
metadata:
  atespace: anything-but-agents
  name: tenantdb-volumes
workerSelector:
  matchLabels:
    workload: tenantdb
containers:
- name: tenantdb
  image: ko://github.com/moficodes/anything-but-agents/cmd/tenantdb
  command:
  - /ko-app/tenantdb
  - --data-dir=/data
  env:
  - name: SNAPSHOT_FIDELITY
    value: SNAPSHOT_FIDELITY_VOLUMES
  wakeupProbe:
    httpGet:
      path: /readyz
      port: 80
  volumeMounts:
  - name: data
    mountPath: /data
resources:
  limits:
    cpuMillicores: 1000
    memoryBytes: 335544320 # 320Mi (1 dedicated slot per 512Mi wp-tenantdb pod)
snapshotConfig:
  preferredFidelity: SNAPSHOT_FIDELITY_VOLUMES
volumes:
- name: data
  durableDir: {}

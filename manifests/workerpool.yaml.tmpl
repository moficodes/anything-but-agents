# Shared WorkerPool for all 5 "Anything But Agents" demos.
# Notice that we only run 3 warm worker pods (`replicas: 3`), yet we will
# multiplex Dungeon instances, Cold-Start Clones, Per-Tenant Databases,
# Honeypots, and Time-Warp nodes across these same 3 workers!

apiVersion: v1
kind: Namespace
metadata:
  name: anything-but-agents

---

apiVersion: ate.dev/v1alpha1
kind: WorkerPool
metadata:
  name: anything-but-agents
  namespace: anything-but-agents
  labels:
    workload: anything-but-agents
spec:
  replicas: 3
  workerImage: ${ATEOM_GVISOR_IMAGE}
  template:
    nodeSelector:
      ate.dev/substrate-version: "${SUBSTRATE_VERSION}"
    resources:
      limits:
        cpu: "1"
        memory: 1Gi
      requests:
        cpu: 250m
        memory: 1Gi

# Dedicated per-workload WorkerPools for "Anything But Agents".
# Isolating each demo into its own labeled WorkerPool prevents high-traffic
# audience workloads (like Dungeon2D) from starving or evicting stage demos,
# while multi-actor bin-packing per ateworker-gvisor pod multiplies concurrent
# actor slots on a small node footprint.
# Note: ateworker-gvisor reserves 64Mi per worker pod (32Mi worker + 2x16Mi
# checkpoint write headroom) from limits.memory when advertising capacity.

apiVersion: v1
kind: Namespace
metadata:
  name: anything-but-agents
  labels:
    ate.dev/api-access: "true"

---
# Demo 0: Slides on Substrate (3 pods x 3 concurrent slides/pod = 9 slots)
apiVersion: ate.dev/v1
kind: WorkerPool
metadata:
  name: wp-slides
  namespace: anything-but-agents
  labels:
    workload: slides
spec:
  replicas: 3
  workerImage: ${ATEOM_GVISOR_IMAGE}
  sandboxClasses:
  - name: gvisor
  template:
    labels:
      workload: slides
    resources:
      limits:
        cpu: "1"
        memory: 512Mi
      requests:
        cpu: 100m
        memory: 512Mi

---

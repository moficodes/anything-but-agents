# Demo 4: Deny-by-default EgressPolicy + MITM Egress Credential Injection (ate-secret://).
# Outbound C2 / lateral VPC traffic is blocked by default at atenet-egress.
# Only allowlisted internal decoy hostnames are permitted, and ate-secret://
# handles are swapped for real secret values only at the egress proxy boundary.
metadata:
  atespace: anything-but-agents
  name: default
rules:
- http:
    hostnames:
    - honeypot-gateway.anything-but-agents.svc.cluster.local
- https:
    hostnames:
    - payroll-vault.acmecorp.internal
    effects:
      replaceHeaders:
      - header: Authorization
        prefix: "Bearer "
        credentialUri: ate-secret://k8s.io/default/anything-but-agents/payroll-vault-api/token

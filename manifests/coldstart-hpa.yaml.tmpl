# Production HPA + Cold-Start QPS Comparison Stack for Act II (`cmd/coldstart`):
#   1. Standard Kubernetes `Deployment/coldstart-k8s` + `Service/coldstart-k8s`
#      running the exact same `cmd/coldstart --mode=worker` binary (12s cold-boot
#      index build before `/readyz` == 200 OK, 20 QPS ceiling per pod).
#   2. Scale target `Deployment/coldstart-substrate-pool` representing the active
#      Agent Substrate actor shard count (`coldstart-1..3`).
#   3. Two identical `autoscaling/v2` `HorizontalPodAutoscaler` objects
#      (`coldstart-k8s` and `coldstart-substrate`, minReplicas: 1, maxReplicas: 3)
#      scaling on the Load Balancer QPS metric `coldstart_lb_qps` (AverageValue: 20).
#   4. `coldstart-gateway` Deployment, Service, RBAC, and `v1beta1.external.metrics.k8s.io`
#      APIService serving the live Load Balancer QPS metrics and split-screen dashboard.

apiVersion: v1
kind: ServiceAccount
metadata:
  name: coldstart-gateway
  namespace: anything-but-agents
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: coldstart-gateway-cluster
rules:
- apiGroups: ["certificates.k8s.io"]
  resources: ["clustertrustbundles"]
  verbs: ["get", "list", "watch"]
- apiGroups: ["external.metrics.k8s.io"]
  resources: ["*"]
  verbs: ["get", "list", "watch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: coldstart-gateway-cluster
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: coldstart-gateway-cluster
subjects:
- kind: ServiceAccount
  name: coldstart-gateway
  namespace: anything-but-agents
- kind: ServiceAccount
  name: horizontal-pod-autoscaler
  namespace: kube-system
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: coldstart-gateway-auth-delegator
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: system:auth-delegator
subjects:
- kind: ServiceAccount
  name: coldstart-gateway
  namespace: anything-but-agents
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: coldstart-gateway-ns
  namespace: anything-but-agents
rules:
- apiGroups: [""]
  resources: ["pods", "services", "endpoints"]
  verbs: ["get", "list", "watch"]
- apiGroups: ["apps"]
  resources: ["deployments", "deployments/scale"]
  verbs: ["get", "list", "watch", "patch", "update"]
- apiGroups: ["autoscaling"]
  resources: ["horizontalpodautoscalers"]
  verbs: ["get", "list", "watch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: coldstart-gateway-ns
  namespace: anything-but-agents
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: coldstart-gateway-ns
subjects:
- kind: ServiceAccount
  name: coldstart-gateway
  namespace: anything-but-agents
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: coldstart-gateway-token-minter
  namespace: ate-system
rules:
- apiGroups: [""]
  resources: ["serviceaccounts/token"]
  resourceNames: ["ate-client"]
  verbs: ["create"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: coldstart-gateway-token-minter
  namespace: ate-system
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: coldstart-gateway-token-minter
subjects:
- kind: ServiceAccount
  name: coldstart-gateway
  namespace: anything-but-agents
---
# 1. Standard Kubernetes Deployment (12s cold-boot index build on every new Pod)
apiVersion: apps/v1
kind: Deployment
metadata:
  name: coldstart-k8s
  namespace: anything-but-agents
  labels:
    app: coldstart-k8s
spec:
  replicas: 1
  selector:
    matchLabels:
      app: coldstart-k8s
  template:
    metadata:
      labels:
        app: coldstart-k8s
    spec:
      containers:
      - name: coldstart
        image: ko://github.com/moficodes/anything-but-agents/cmd/coldstart
        command:
        - /ko-app/coldstart
        - --mode=worker
        - --addr=:8080
        - --init-delay=12s
        - --corpus-docs=50000
        - --sieve-limit=1000000
        - --max-concurrent=4
        - --min-query-duration=200ms
        ports:
        - containerPort: 8080
          name: http
        readinessProbe:
          httpGet:
            path: /readyz
            port: 8080
          periodSeconds: 1
          timeoutSeconds: 1
          successThreshold: 1
          failureThreshold: 3
        resources:
          requests:
            cpu: 250m
            memory: 256Mi
          limits:
            cpu: "1"
            memory: 512Mi
---
apiVersion: v1
kind: Service
metadata:
  name: coldstart-k8s
  namespace: anything-but-agents
  labels:
    app: coldstart-k8s
spec:
  type: ClusterIP
  selector:
    app: coldstart-k8s
  ports:
  - name: http
    port: 80
    targetPort: 8080
---
# 1b. In-Cluster L7 HTTP Router for Standard Kubernetes (`coldstart-k8s-router`)
#     Mirrors `atenet-router` hop-for-hop (`coldstart-gateway -> svc/coldstart-k8s-router
#     -> Ready Endpoints of Service/coldstart-k8s`) so both tracks traverse an identical
#     2-hop Service + L7 proxy path on GKE.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: coldstart-k8s-router
  namespace: anything-but-agents
  labels:
    app: coldstart-k8s-router
spec:
  replicas: 1
  selector:
    matchLabels:
      app: coldstart-k8s-router
  template:
    metadata:
      labels:
        app: coldstart-k8s-router
    spec:
      serviceAccountName: coldstart-gateway
      containers:
      - name: router
        image: ko://github.com/moficodes/anything-but-agents/cmd/coldstart
        command:
        - /ko-app/coldstart
        - --mode=k8s-router
        - --addr=:8080
        - --namespace=anything-but-agents
        - --target-service=coldstart-k8s
        ports:
        - containerPort: 8080
          name: http
        readinessProbe:
          httpGet:
            path: /readyz
            port: 8080
        resources:
          requests:
            cpu: 100m
            memory: 64Mi
          limits:
            cpu: 500m
            memory: 256Mi
---
apiVersion: v1
kind: Service
metadata:
  name: coldstart-k8s-router
  namespace: anything-but-agents
  labels:
    app: coldstart-k8s-router
spec:
  type: ClusterIP
  selector:
    app: coldstart-k8s-router
  ports:
  - name: http
    port: 80
    targetPort: 8080
---
# 2. Scale Target Holder for Active Substrate Actor Replicas (`coldstart-1..3`)
apiVersion: apps/v1
kind: Deployment
metadata:
  name: coldstart-substrate-pool
  namespace: anything-but-agents
  labels:
    app: coldstart-substrate-pool
spec:
  replicas: 1
  selector:
    matchLabels:
      app: coldstart-substrate-pool
  template:
    metadata:
      labels:
        app: coldstart-substrate-pool
    spec:
      containers:
      - name: pause
        image: registry.k8s.io/pause:3.10
        resources:
          requests:
            cpu: 1m
            memory: 8Mi
---
# 3. Standard Kubernetes HPA (`coldstart-k8s`) — minReplicas: 1, maxReplicas: 3
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: coldstart-k8s
  namespace: anything-but-agents
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: coldstart-k8s
  minReplicas: 1
  maxReplicas: 3
  metrics:
  - type: External
    external:
      metric:
        name: coldstart_lb_qps
        selector:
          matchLabels:
            backend: k8s
      target:
        type: AverageValue
        averageValue: "20"
  behavior:
    scaleUp:
      stabilizationWindowSeconds: 0
      selectPolicy: Max
      policies:
      - type: Pods
        value: 3
        periodSeconds: 15
    scaleDown:
      stabilizationWindowSeconds: 60
      selectPolicy: Max
      policies:
      - type: Pods
        value: 2
        periodSeconds: 15
---
# 4. Agent Substrate Actor Pool HPA (`coldstart-substrate`) — Identical spec!
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: coldstart-substrate
  namespace: anything-but-agents
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: coldstart-substrate-pool
  minReplicas: 1
  maxReplicas: 3
  metrics:
  - type: External
    external:
      metric:
        name: coldstart_lb_qps
        selector:
          matchLabels:
            backend: substrate
      target:
        type: AverageValue
        averageValue: "20"
  behavior:
    scaleUp:
      stabilizationWindowSeconds: 0
      selectPolicy: Max
      policies:
      - type: Pods
        value: 3
        periodSeconds: 15
    scaleDown:
      stabilizationWindowSeconds: 60
      selectPolicy: Max
      policies:
      - type: Pods
        value: 2
        periodSeconds: 15
---
# 5. Coldstart Dual Load-Balancer, Traffic Generator, Dashboard & External Metrics Server
apiVersion: apps/v1
kind: Deployment
metadata:
  name: coldstart-gateway
  namespace: anything-but-agents
  labels:
    app: coldstart-gateway
spec:
  replicas: 1
  selector:
    matchLabels:
      app: coldstart-gateway
  template:
    metadata:
      labels:
        app: coldstart-gateway
    spec:
      serviceAccountName: coldstart-gateway
      initContainers:
      - name: copy-kubectl-ate
        image: ${KUBECTL_ATE_IMAGE}
        command: ["/bin/cp", "/ko-app/kubectl-ate", "/tools/kubectl-ate"]
        volumeMounts:
        - name: tools
          mountPath: /tools
      containers:
      - name: gateway
        image: ko://github.com/moficodes/anything-but-agents/cmd/coldstart
        command:
        - /ko-app/coldstart
        - --mode=gateway
        - --addr=:8080
        - --metrics-addr=:6443
        - --namespace=anything-but-agents
        - --atespace=anything-but-agents
        - --template=coldstart
        - --k8s-service-url=http://coldstart-k8s-router.anything-but-agents.svc.cluster.local:80
        - --router-url=http://atenet-router.ate-system.svc.cluster.local:80
        - --ate-endpoint=api.ate-system.svc:443
        - --kubectl-ate-bin=/tools/kubectl-ate
        volumeMounts:
        - name: tools
          mountPath: /tools
        ports:
        - containerPort: 8080
          name: http
        - containerPort: 6443
          name: https-metrics
        readinessProbe:
          httpGet:
            path: /readyz
            port: 8080
        resources:
          requests:
            cpu: 250m
            memory: 256Mi
          limits:
            cpu: "1"
            memory: 512Mi
      volumes:
      - name: tools
        emptyDir: {}
---
apiVersion: v1
kind: Service
metadata:
  name: coldstart-gateway
  namespace: anything-but-agents
  labels:
    app: coldstart-gateway
spec:
  type: LoadBalancer
  selector:
    app: coldstart-gateway
  ports:
  - name: http
    port: 80
    targetPort: 8080
  - name: https
    port: 443
    targetPort: 6443
---
apiVersion: apiregistration.k8s.io/v1
kind: APIService
metadata:
  name: v1beta1.external.metrics.k8s.io
spec:
  service:
    name: coldstart-gateway
    namespace: anything-but-agents
    port: 443
  group: external.metrics.k8s.io
  version: v1beta1
  insecureSkipTLSVerify: true
  groupPriorityMinimum: 100
  versionPriority: 100

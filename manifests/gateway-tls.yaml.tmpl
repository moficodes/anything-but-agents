# Global External Application Load Balancer (GKE Gateway API) with Google Cloud
# Certificate Manager TLS for all 5 interactive demos + Demo 0 slides:
#   - https://${SLIDES_DOMAIN}         -> svc/slides-gateway:80
#   - https://slides.${DEMO_DOMAIN}    -> svc/slides-gateway:80
#   - https://dungeon.${DEMO_DOMAIN}   -> svc/dungeon2d-gateway:80
#   - https://coldstart.${DEMO_DOMAIN} -> svc/coldstart-gateway:80
#   - https://tenantdb.${DEMO_DOMAIN}  -> svc/tenantdb-gateway:80
#   - https://honeypot.${DEMO_DOMAIN}  -> svc/honeypot-gateway:80
#   - https://timewarp.${DEMO_DOMAIN}  -> svc/timewarp-gateway:80
apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: anything-but-agents-gateway
  namespace: anything-but-agents
  annotations:
    networking.gke.io/certmap: ${CERT_MAP_NAME}
spec:
  gatewayClassName: gke-l7-global-external-managed
  addresses:
  - type: NamedAddress
    value: ${GATEWAY_IP_NAME}
  listeners:
  - name: https
    protocol: HTTPS
    port: 443
    allowedRoutes:
      namespaces:
        from: Same
  - name: http
    protocol: HTTP
    port: 80
    allowedRoutes:
      namespaces:
        from: Same
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: anything-but-agents-https-redirect
  namespace: anything-but-agents
spec:
  parentRefs:
  - name: anything-but-agents-gateway
    sectionName: http
  rules:
  - filters:
    - type: RequestRedirect
      requestRedirect:
        scheme: https
        statusCode: 301
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: slides-https-route
  namespace: anything-but-agents
spec:
  parentRefs:
  - name: anything-but-agents-gateway
    sectionName: https
  hostnames:
  - "${SLIDES_DOMAIN}"
  - "slides.${DEMO_DOMAIN}"
  rules:
  - backendRefs:
    - name: slides-gateway
      port: 80
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: dungeon2d-https-route
  namespace: anything-but-agents
spec:
  parentRefs:
  - name: anything-but-agents-gateway
    sectionName: https
  hostnames:
  - "dungeon.${DEMO_DOMAIN}"
  rules:
  - backendRefs:
    - name: dungeon2d-gateway
      port: 80
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute

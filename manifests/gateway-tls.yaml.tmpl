---
apiVersion: networking.gke.io/v1
kind: HealthCheckPolicy
metadata:
  name: slides-gateway-healthcheck
  namespace: anything-but-agents
spec:
  default:
    checkIntervalSec: 10
    timeoutSec: 5
    healthyThreshold: 1
    unhealthyThreshold: 3
    config:
      type: HTTP
      httpHealthCheck:
        portSpecification: USE_SERVING_PORT
        requestPath: /readyz
  targetRef:
    group: ""
    kind: Service
    name: slides-gateway
---

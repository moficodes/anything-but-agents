# Demo 8: "Figma-Style Multiplayer Collaborative Canvas & Document Rooms"
# Each document room is an isolated in-memory actor (doc-merger-acquisition,
# doc-q4-roadmap, doc-incident-postmortem) maintaining its entire scene graph
# in Go heap RAM (SNAPSHOT_FIDELITY_MEMORY). The container contains ZERO auth code;
# OpenFGA AccessPolicy relationship authorization is enforced at the perimeter
# before the actor is woken from GCS.
metadata:
  atespace: anything-but-agents
  name: canvas
workerSelector:
  matchLabels:
    workload: canvas
containers:
- name: canvas
  image: ko://github.com/moficodes/anything-but-agents/cmd/canvas
  command:
  - /ko-app/canvas
  - --mode=actor
  - --addr=:80
  wakeupProbe:
    httpGet:
      path: /readyz
      port: 80
resources:
  limits:
    cpuMillicores: 300
    memoryBytes: 134217728 # 128Mi (fits 3 concurrent rooms per 512Mi wp-canvas pod)
snapshotConfig:
  preferredFidelity: SNAPSHOT_FIDELITY_MEMORY
